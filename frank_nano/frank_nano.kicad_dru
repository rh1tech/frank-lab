(version 1)
# RP2350A QFN-60 (0.4 mm pitch, 0.2 mm pads leave 0.2 mm): allow 0.15 mm at the QFN-60 pads only.
(rule "QFN-60 fine pitch"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('FRANK:QFN-60*') || B.memberOfFootprint('FRANK:QFN-60*')"))

# 0402 cap or resistor with its own power-rail via under the body: via ring to the other pad is 0.175 mm by design.
(rule "0402 part with via: via to its other pad"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('FRANK:*Metric_small_pads_Via*') && B.memberOfFootprint('FRANK:*Metric_small_pads_Via*')"))

# RP2350 VREG / USB-27R corner copied from the Raspberry Pi RP2350 QFN-60 minimal design: its geometry uses 0.15 mm clearance.
(rule "RPi VREG block clearance"
	(constraint clearance (min 0.15mm))
	(condition "A.NetName == '/RP2350A/VREG_LX' || A.NetName == '/RP2350A/VREG_AVDD' || A.NetName == '+1V1_A' || A.NetName == 'Net-(U2-USB_DP)' || A.NetName == 'Net-(U2-USB_DM)' || A.memberOfFootprint('C2') || A.memberOfFootprint('C5') || A.memberOfFootprint('L1') || A.memberOfFootprint('C7') || A.memberOfFootprint('R2') || A.memberOfFootprint('R5') || A.memberOfFootprint('R6') || A.memberOfFootprint('C17')"))

# The AVDD cap sits inside U2's courtyard exactly as in the reference.
(rule "RPi reference parts inside U2 courtyard"
	(constraint courtyard_clearance (min -3mm))
	(condition "A.Reference == 'U2' && B.Reference == 'C7'"))
