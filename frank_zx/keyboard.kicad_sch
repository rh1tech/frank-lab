	(text "40-key matrix (10x4)\nCherry MX + 1N4148W, universal SOD-123 / SOD-323 pads (1N4148WS fits too)\nROW bus above keys (parallel); COL via diodes (cathode to COL)\nCOL0-9=GPIO20-29  ROW0-3=GPIO30-33\nScan: drive one COL low, read ROW0-3 with internal pull-ups\n(pull-up scheme avoids RP2350 erratum E9 on pull-downs)"
		(exclude_from_sim no)
		(at 40.64 160 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
