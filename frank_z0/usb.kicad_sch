	(text "J7 PIO-USB host (as on Waveshare RP2350-PiZero): CC 5.1K, U7 TPD4S012 ESD, R13/R14 22R series.\nGPIO21 = D+, GPIO22 = D-. VBUS comes from the board VBUS rail (5 V to the device)."
		(exclude_from_sim no)
		(at 172.72 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4e063e73-d763-4a3f-be38-afe0db9487dc")
	)
	(text "J8 native USB-C (RP2350 USB device / BOOTSEL, 5 V power in): CC 5.1K = sink, U8 TPD4S012 ESD at the connector.\nSeries 27R for USB_DP/DM sit at the RP2350 (MCU sheet)."
		(exclude_from_sim no)
