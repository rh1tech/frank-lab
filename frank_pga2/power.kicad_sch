	)
	(text "Q2 gate = +5V_DC (R18 1K / R19 100K): Q2 stays off while the buck runs and turns on\nonly after +5V_DC has collapsed - no back-feed into the PC on DC unplug, and USB\ntakes over if DC is present but below UVLO."
		(exclude_from_sim no)
		(at 256.54 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
