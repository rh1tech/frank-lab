	(text "USB-C 5V input: auto-select P-FET\n(off while the buck is running)\nUSB-C power: 1.5A max for the whole board (F2 hold)"
		(exclude_from_sim no)
		(at 256.54 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
