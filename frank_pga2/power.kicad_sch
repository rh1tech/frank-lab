			)
			(justify left top)
		)
		(uuid "4a2965f7-7409-4556-abb2-58a6fa7d6857")
	)
	(text "Power switch: Q1 high-side, S5 only pulls the gate; R16/C20 soft start; JP1 \"Force On\"."
		(exclude_from_sim no)
		(at 156.21 140.97 0)
		(effects
