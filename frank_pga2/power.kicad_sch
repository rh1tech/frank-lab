		(uuid "2c0e5516-b67b-4dfc-90f3-f1e7210edcf1")
	)
	(text "DC IN 9-12V (centre +, max 15V: SMAJ15A D5 starts conducting at ~16.7V).  F1 PTC 1812, D1 SS34 reverse-polarity protection (a diode, not a P-FET,\nso the buck stops when the plug is pulled and the USB FET takes over once +5V_DC collapses).\nMP1584EN: UVLO ~6.5V (R9/R10 100K/30K), Vout 0.8*(1+47K/8.2K) = 5.39V before the OR diode, FREQ 100K ~1MHz."
		(exclude_from_sim no)
		(at 60.96 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3ca557ba-aded-45ac-b040-c9505f392a42")
	)
