	)
	(text "USB-C: CC 5.1K = sink; USBLC6 ESD right behind the connector. Series 27R is at the RP2350 (R25/R26)."
		(exclude_from_sim no)
		(at 50.8 60.96 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "57fc0ae0-6389-494b-8fba-40c419beca23")
	)
	(text "BOOTSEL latch U14A: on the RUN rising edge it stores the BOOTSEL button: held -> Q = L -> USB-C, released -> Q = H -> hub."
		(exclude_from_sim no)
		(at 50.8 140.97 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "66f1f065-245a-431d-b2fa-e8a20051142d")
	)
	(text "R64/C61 delay RUN (late clock edge after +3V3 is up).\n74HC74D: D is steady during the slow RUN edge, so extra clocks store the same value.\nJP2 forces hub (~S); S2-3 / JP5 force USB-C (~R). Never enable both overrides."
		(exclude_from_sim no)
		(at 50.8 153.67 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "bd8bb834-f0ba-4db7-bcff-8b7d237ae18e")
	)
	(text "TS3USB221 mux: S = L -> USB-C (BOOTSEL / device),  S = H -> hub (RP is USB host for keyboard / mouse)."
		(exclude_from_sim no)
		(at 50.8 64.77 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c12684d6-2eab-4a67-b95e-f54dd826a833")
	)
